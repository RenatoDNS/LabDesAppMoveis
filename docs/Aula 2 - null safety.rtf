  print(resposta);\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Caso 
\f2\fs26 nome
\f1\fs24  seja 
\f2\fs26 null
\f1\fs24 , 
\f2\fs26 resposta
\f1\fs24  receber\'e1 "Nome padr\'e3o".\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 5. Null Safety em listas\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0 \cf0 Podemos aplicar Null Safety tamb\'e9m em estruturas como listas:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 void main() \{\
  List<String?> lista = ["Gol", null, "Ka"];\
  print(lista);\
\}\
