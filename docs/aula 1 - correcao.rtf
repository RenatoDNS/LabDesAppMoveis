\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Estrutura Correta do C\'f3digo\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Embora o exemplo acima funcione, essa abordagem n\'e3o \'e9 produtiva. O ideal \'e9 separar o texto em uma classe que estenda um 
\f0\b widget
\f1\b0  adequado.\
Crie a classe 
\f2\fs26 MyApp
\f1\fs24  estendendo 
\f2\fs26 StatelessWidget
\f1\fs24 :\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 class MyApp extends StatelessWidget \{\
  @override\
  Widget build(BuildContext context) \{\
    return MaterialApp(\
      home: Text('Hello World!'),\
    );\
  \}\
\}\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Agora, modifique o 
\f2\fs26 main.dart
\f1\fs24  para chamar 
\f2\fs26 MyApp
\f1\fs24 :\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 void main() \{\
  runApp(MyApp());\
\}\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Trabalhando com Stateful Widgets\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 O 
\f2\fs26 StatelessWidget
\f1\fs24  funciona bem para conte\'fado est\'e1tico, mas para interfaces din\'e2micas utilizamos 
\f2\fs26 StatefulWidget
\f1\fs24 .\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 class MyApp extends StatefulWidget \{\
  @override\
  State<StatefulWidget> createState() \{\
    return MyAppState();\
  \}\
\}\
\
class MyAppState extends State<MyApp> \{\
  var resposta = 0;\
\
  void calcular() \{\
    setState(() \{\
      resposta = 80 * 2;\
    \});\
  \}\
\
  @override\
  Widget build(BuildContext context) \{\
    return MaterialApp(\
      home: Scaffold(\
        appBar: AppBar(title: Text('Primeira Aplica\'e7\'e3o')),\
        body: Column(\
          children: [\
            Text('Informe seus dados'),\
            ElevatedButton(child: Text('Calcular'), onPressed: calcular),\
            Text('Resposta: ' + resposta.toString())\
          ],\
        ),\
      ),\
    );\
  \}\
\}\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Criando um Formul\'e1rio para Capturar Dados\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Agora, vamos criar uma aplica\'e7\'e3o que captura 
\f0\b peso
\f1\b0  e 
\f0\b altura
\f1\b0  para calcular o IMC:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 import 'package:flutter/material.dart';\
\
void main() \{\
  runApp(MyApp());\
\}\
\
class MyApp extends StatelessWidget \{\
  @override\
  Widget build(BuildContext context) \{\
    return MaterialApp(\
      title: 'Calculadora de IMC',\
      home: HomePage(),\
    );\
  \}\
\}\
\
class HomePage extends StatefulWidget \{\
  @override\
  _HomePageState createState() => _HomePageState();\
\}\
\
class _HomePageState extends State<HomePage> \{\
  final _tPeso = TextEditingController();\
  final _tAltura = TextEditingController();\
  var _infoText = "Informe seus dados!";\
\
  void _calcular() \{\
    setState(() \{\
      double peso = double.parse(_tPeso.text);\
      double altura = double.parse(_tAltura.text) / 100;\
      double imc = peso / (altura * altura);\
      String imcStr = imc.toStringAsPrecision(4);\
      if (imc < 17) \{\
        _infoText = "Muito abaixo do peso ($imcStr)";\
      \} else if (imc < 18.5) \{\
        _infoText = "Abaixo do Peso ($imcStr)";\
      \} else if (imc < 25) \{\
        _infoText = "Peso Normal ($imcStr)";\
      \} else if (imc < 30) \{\
        _infoText = "Acima do Peso ($imcStr)";\
      \} else if (imc < 35) \{\
        _infoText = "Obesidade Grau I ($imcStr)";\
      \} else if (imc < 40) \{\
        _infoText = "Obesidade Grau II ($imcStr)";\
      \} else \{\
        _infoText = "Obesidade Grau III ($imcStr)";\
      \}\
    \});\
  \}\
\
  @override\
  Widget build(BuildContext context) \{\
    return Scaffold(\
      appBar: AppBar(title: Text("Calculadora de IMC"), centerTitle: true),\
      body: Padding(\
        padding: EdgeInsets.all(15.0),\
        child: Column(\
          children: <Widget>[\
            _editText("Peso (kg)", _tPeso),\
            _editText("Altura (cm)", _tAltura),\
            ElevatedButton(onPressed: _calcular, child: Text("Calcular")),\
            Text(\
              _infoText,\
              textAlign: TextAlign.center,\
              style: TextStyle(color: Colors.blue, fontSize: 25.0),\
            ),\
          ],\
        ),\
      ),\
    );\
  \}\
\
  Widget _editText(String label, TextEditingController controller) \{\
    return TextFormField(\
      controller: controller,\
      keyboardType: TextInputType.number,\
      decoration: InputDecoration(labelText: label),\
    );\
  \}\
\}\
\pard\pardeftab720\sa280\partightenfactor0

